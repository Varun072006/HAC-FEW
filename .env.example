# Environment Configuration
ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# LLM Providers (Ollama default, OpenAI/Anthropic fallback)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.1:8b
FALLBACK_HOSTED_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_agents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_agents

# Embeddings & RAG
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.65

# Mock Enterprise Systems
MOCK_SYSTEMS_BASE_URL=http://localhost:8001

# Observability (Langfuse / OpenTelemetry)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- HAC-FEW platform (apps/api, apps/console) ----
# development | production. Production refuses to start without HACFEW_JWT_SECRET and seeds no accounts.
HACFEW_ENV=development
# >= 32 random characters. In development one is generated and kept in .hacfew/ (git-ignored).
HACFEW_JWT_SECRET=
# Platform state (users, workflows, runs, events, approvals, audit). Separate from the mock systems DB.
PLATFORM_DATABASE_URL=sqlite:///./hacfew_platform.db
# Password for the seeded development accounts. Ignored in production.
HACFEW_DEV_PASSWORD=hacfew-dev
HACFEW_TOKEN_TTL_SECONDS=28800
HACFEW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Legacy unauthenticated POST /workflows/run (trusts a client-supplied role). Off unless set to 1.
HACFEW_ENABLE_LEGACY_API=0
